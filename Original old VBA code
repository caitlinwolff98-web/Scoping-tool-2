    outputWs.Name = "Pack Number Company Table"
    
    ' Get segment tabs
    Set segmentTabs = GetTabsForCategory(ModConfig.CAT_SEGMENT)
    
    ' Process each segment tab
    For i = 1 To segmentTabs.count
