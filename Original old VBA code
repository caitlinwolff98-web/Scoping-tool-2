    Dim row As Long
    Dim fsliKeyWs As Worksheet
    Dim manualWs As Worksheet
    Dim lastRow As Long
    Dim fsliRow As Long
    Dim fsliName As String
    
    row = startRow
    
    ' Section title
    ws.Cells(row, 1).value = "PER-FSLI COVERAGE ANALYSIS"
    ws.Cells(row, 1).Font.Bold = True
    ws.Cells(row, 1).Font.Size = 12
    ws.Range("A" & row & ":G" & row).Merge
    ws.Range("A" & row & ":G" & row).Interior.Color = RGB(217, 225, 242)
    row = row + 2
    
    ' Column headers
    ws.Cells(row, 1).value = "FSLI"
    ws.Cells(row, 2).value = "Total Amount"
    ws.Cells(row, 3).value = "Scoped In Amount"
    ws.Cells(row, 4).value = "% Scoped In"
    ws.Cells(row, 5).value = "% Untested"
    ws.Cells(row, 6).value = "Status"
    ws.Cells(row, 7).value = "Recommendation"
    
    With ws.Range("A" & row & ":G" & row)
        .Font.Bold = True
        .Interior.Color = RGB(68, 114, 196)
        .Font.Color = RGB(255, 255, 255)
    End With
    row = row + 1
    
    ' Get unique FSLIs from Manual Scoping sheet
    Set manualWs = g_OutputWorkbook.Worksheets("Manual Scoping")
    Set fsliKeyWs = g_OutputWorkbook.Worksheets("FSLi Key Table")
    
    If Not manualWs Is Nothing And Not fsliKeyWs Is Nothing Then
        lastRow = fsliKeyWs.Cells(fsliKeyWs.Rows.count, 1).End(xlUp).row
        
        For fsliRow = 2 To lastRow
            fsliName = fsliKeyWs.Cells(fsliRow, 1).value
            
            ' FSLI name
            ws.Cells(row, 1).value = fsliName
            
            ' Total amount for this FSLI across all packs
            ws.Cells(row, 2).Formula = "=SUMIF('Manual Scoping'!D:D,A" & row & ",'Manual Scoping'!G:G)"
            ws.Cells(row, 2).NumberFormat = "#,##0"
            
            ' Scoped in amount
            ws.Cells(row, 3).Formula = "=SUMIFS('Manual Scoping'!G:G,'Manual Scoping'!D:D,A" & row & ",'Manual Scoping'!M:M,""Scope In"")"
            ws.Cells(row, 3).NumberFormat = "#,##0"
            
            ' % Scoped In
            ws.Cells(row, 4).Formula = "=IF(B" & row & "<>0,C" & row & "/B" & row & ",0)"
            ws.Cells(row, 4).NumberFormat = "0.00%"
            
            ' % Untested
            ws.Cells(row, 5).Formula = "=1-D" & row
            ws.Cells(row, 5).NumberFormat = "0.00%"
            
            ' Status (color-coded based on coverage)
            ws.Cells(row, 6).Formula = "=IF(D" & row & ">=0.7,""Sufficient"",IF(D" & row & ">=0.5,""Partial"",""Insufficient""))"
            
            ' Conditional formatting for status
            Dim statusCell As Range
            Set statusCell = ws.Cells(row, 6)
            statusCell.FormatConditions.Delete
            
            With statusCell.FormatConditions.Add(xlCellValue, xlEqual, "=""Sufficient""")
                .Interior.Color = RGB(198, 239, 206)
            End With
            
            With statusCell.FormatConditions.Add(xlCellValue, xlEqual, "=""Insufficient""")
                .Interior.Color = RGB(255, 199, 206)
            End With
            
            ' Recommendation
            ws.Cells(row, 7).Formula = "=IF(D" & row & "<0.5,""Scope in more packs"",IF(D" & row & "<0.7,""Review high-value packs"",""Adequate coverage""))"
            
            row = row + 1
        Next fsliRow
    End If
    
    ' Create table
    Dim tbl As ListObject
    On Error Resume Next
    Set tbl = ws.ListObjects.Add(xlSrcRange, ws.Range("A" & (startRow + 2) & ":G" & (row - 1)), , xlYes)
    If Not tbl Is Nothing Then
        tbl.Name = "FSLI_Coverage_Analysis"
        tbl.TableStyle = "TableStyleMedium2"
    End If
    
    On Error GoTo 0
End Sub

