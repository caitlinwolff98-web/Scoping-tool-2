    On Error Resume Next
    Application.DisplayAlerts = False
    g_OutputWorkbook.Worksheets("Pack Number Company Table").Delete
    Application.DisplayAlerts = True
    On Error GoTo ErrorHandler
    
    ' Create output worksheet
