' Update scoping status for selected packs
Private Sub UpdateScopingStatus(newStatus As String)
    On Error GoTo ErrorHandler
    
    Dim selectedCells As Range
    Dim cell As Range
    Dim packCode As String
    Dim controlTable As Worksheet
    Dim updateCount As Long
    Dim lastRow As Long
    Dim i As Long
    
    ' Check if anything is selected
    If TypeName(Selection) <> "Range" Then
        MsgBox "Please select pack(s) to update.", vbExclamation
        Exit Sub
    End If
    
    Set selectedCells = Selection
    Set controlTable = g_OutputWorkbook.Worksheets("Scoping Control Table")
    
    ' Get last row
    lastRow = controlTable.Cells(controlTable.Rows.count, 2).End(xlUp).row
    
    ' Process each selected cell
    For Each cell In selectedCells
        ' Try to get pack code from current row
        On Error Resume Next
        packCode = cell.EntireRow.Cells(1, Application.WorksheetFunction.Match("Pack Code", g_ManualScopingWs.Rows(21), 0)).value
        On Error GoTo ErrorHandler
        
        If packCode <> "" And packCode <> "Pack Code" Then
            ' Update all rows for this pack in control table
            For i = 2 To lastRow
                If controlTable.Cells(i, 2).value = packCode Then
                    If controlTable.Cells(i, 7).value <> "Yes" Then ' Not consolidated
                        controlTable.Cells(i, 6).value = newStatus
                        controlTable.Cells(i, 9).value = "Yes" ' Manual override
                        controlTable.Cells(i, 10).value = Date ' Override date
                        controlTable.Cells(i, 11).value = Application.UserName ' Override by
                        updateCount = updateCount + 1
                    End If
                End If
            Next i
        End If
    Next cell
    
    If updateCount > 0 Then
        ' Refresh pivot
        g_ScopingPivot.RefreshTable
        
        ' Update timestamp
        g_LastUpdateTime = Now
        
        MsgBox updateCount & " rows updated to '" & newStatus & "'", vbInformation
    Else
        MsgBox "No valid packs selected for update.", vbExclamation
    End If
    
    Exit Sub
    
ErrorHandler:
    MsgBox "Error updating scoping status: " & Err.Description, vbCritical
End Sub

