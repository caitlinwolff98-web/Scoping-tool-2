Private Sub CreateScopingControlSheet()
    On Error GoTo ErrorHandler
    
    Dim ws As Worksheet
    Dim fullInputWs As Worksheet
    Dim percentWs As Worksheet
    Dim lastRow As Long
    Dim lastCol As Long
    Dim row As Long
    Dim col As Long
    Dim outRow As Long
    Dim outCol As Long
    
    ' Check if sheet exists and delete it
    On Error Resume Next
    Application.DisplayAlerts = False
    g_OutputWorkbook.Worksheets("Scoping Control Table").Delete
    Application.DisplayAlerts = True
    On Error GoTo ErrorHandler
    
    ' Create new sheet
    Set ws = g_OutputWorkbook.Worksheets.Add
    ws.Name = "Scoping Control Table"
    
    ' Get source data
    Set fullInputWs = g_OutputWorkbook.Worksheets("Full Input Table")
    Set percentWs = g_OutputWorkbook.Worksheets("Full Input Percentage")
    
    If fullInputWs Is Nothing Or percentWs Is Nothing Then
        MsgBox "Full Input Table or Full Input Percentage table not found.", vbCritical
        Exit Sub
    End If
    
    ' Get dimensions
    lastRow = fullInputWs.Cells(fullInputWs.Rows.count, 1).End(xlUp).row
    lastCol = fullInputWs.Cells(1, fullInputWs.columns.count).End(xlToLeft).Column
    
    ' CRITICAL: Create headers - Pack Info + FSLIs (amounts) + FSLIs (percentages)
    ws.Cells(1, 1).value = "Pack Name"
    ws.Cells(1, 2).value = "Pack Code"
    ws.Cells(1, 3).value = "Segment"
    ws.Cells(1, 4).value = "Division"
    ws.Cells(1, 5).value = "Scoping Status"
    
    '' Add FSLI amount columns (starting from column 6)
    ' FIXED: Only use columns from Full Input Table (which already has only consolidation currency)
    outCol = 6
    For col = 5 To lastCol  ' Column 5 onwards in Full Input Table are FSLIs
        ws.Cells(1, outCol).value = fullInputWs.Cells(1, col).value & " (Amount)"
        outCol = outCol + 1
    Next col
    
    ' Add FSLI percentage columns (continue from where amounts ended)
    For col = 5 To lastCol
        ws.Cells(1, outCol).value = fullInputWs.Cells(1, col).value & " (%)"
        outCol = outCol + 1
    Next col
    
    ' Populate pack information and data
    outRow = 2
    For row = 2 To lastRow
        ' Pack information
        ws.Cells(outRow, 1).value = fullInputWs.Cells(row, 1).value  ' Pack Name
        ws.Cells(outRow, 2).value = fullInputWs.Cells(row, 2).value  ' Pack Code
        ws.Cells(outRow, 3).value = fullInputWs.Cells(row, 3).value  ' Segment
        ws.Cells(outRow, 4).value = fullInputWs.Cells(row, 4).value  ' Division
        ws.Cells(outRow, 5).value = "Not Scoped Yet"  ' Default status
        
        ' FIXED: Copy amounts from Full Input Table (consolidation currency only)
        outCol = 6
        For col = 5 To lastCol
            ws.Cells(outRow, outCol).value = fullInputWs.Cells(row, col).value
            ws.Cells(outRow, outCol).NumberFormat = "#,##0"
            outCol = outCol + 1
        Next col
        
        ' FIXED: Copy percentages from Full Input Percentage table (not calculate!)
        For col = 5 To lastCol
            ws.Cells(outRow, outCol).value = percentWs.Cells(row, col).value
            ws.Cells(outRow, outCol).NumberFormat = "0.00%"
            outCol = outCol + 1
        Next col
        
        outRow = outRow + 1
    Next row
    
    ' Format headers
    With ws.Range("A1").CurrentRegion.Rows(1)
        .Font.Bold = True
        .Interior.Color = RGB(68, 114, 196)
        .Font.Color = RGB(255, 255, 255)
        .WrapText = True
    End With
    
    ' Freeze panes
    ws.Activate
    ws.Range("F2").Select
    ActiveWindow.FreezePanes = True
    ws.Range("A1").Select
    
    ws.columns.AutoFit
    
    Exit Sub
    
ErrorHandler:
    Debug.Print "Error creating Scoping Control Sheet: " & Err.Description
    MsgBox "Error creating Scoping Control Table: " & Err.Description, vbCritical
End Sub

'' PUBLIC: Update scoping from Manual Scoping sheet (called by button) - OPTIMIZED
Public Sub UpdateScopingFromManualSheet()
    On Error GoTo ErrorHandler
    
    ' Disable screen updating and calculations for speed
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    Application.EnableEvents = False
    
    Dim manualWs As Worksheet
    Dim controlWs As Worksheet
    Dim lastRow As Long
    Dim row As Long
    Dim packCode As String
    Dim scopingStatus As String
    Dim updateCount As Long
    
    ' Create dictionary for fast lookup
    Dim packStatusDict As Object
    Set packStatusDict = CreateObject("Scripting.Dictionary")
    
    Set manualWs = ActiveWorkbook.Worksheets("Manual Scoping")
    Set controlWs = ActiveWorkbook.Worksheets("Scoping Control Table")
    
    If manualWs Is Nothing Or controlWs Is Nothing Then
        MsgBox "Required sheets not found.", vbCritical
        GoTo CleanUp
    End If
    
    ' OPTIMIZATION 1: Build dictionary of scoping statuses first (FAST)
    lastRow = manualWs.Cells(manualWs.Rows.count, 2).End(xlUp).row
    
    For row = 5 To lastRow
        packCode = Trim(manualWs.Cells(row, 2).value)
        scopingStatus = Trim(manualWs.Cells(row, 13).value)
        
        If packCode <> "" Then
            ' Store most recent status for each pack (assumes multiple FSLIs per pack)
            ' Use most common non-default status
            If scopingStatus = "Scope In" Then
                packStatusDict(packCode) = "Scope In"
            ElseIf scopingStatus = "Scoped Out" And Not packStatusDict.Exists(packCode) Then
                packStatusDict(packCode) = "Scoped Out"
            ElseIf scopingStatus = "Under Review" And Not packStatusDict.Exists(packCode) Then
                packStatusDict(packCode) = "Under Review"
            ElseIf Not packStatusDict.Exists(packCode) Then
                packStatusDict(packCode) = scopingStatus
            End If
        End If
    Next row
    
    ' OPTIMIZATION 2: Update control table in one pass (FAST)
    lastRow = controlWs.Cells(controlWs.Rows.count, 2).End(xlUp).row
    
    For row = 2 To lastRow
        packCode = Trim(controlWs.Cells(row, 2).value)
        
        If packStatusDict.Exists(packCode) Then
            controlWs.Cells(row, 4).value = packStatusDict(packCode)
            updateCount = updateCount + 1
        End If
    Next row
    
CleanUp:
    ' Re-enable screen updating
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    
    If Err.Number = 0 Then
        MsgBox "Scoping tables updated successfully!" & vbCrLf & _
               "Updated " & updateCount & " pack statuses.", _
               vbInformation, "Update Complete"
    End If
    
    Exit Sub
    
ErrorHandler:
    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    Application.ScreenUpdating = True
    MsgBox "Error updating scoping: " & Err.Description, vbCritical
End Sub

' Find pack in control table
Private Function FindPackInControlTable(ws As Worksheet, packCode As String) As Long
    Dim lastRow As Long
    Dim row As Long
    
    lastRow = ws.Cells(ws.Rows.count, 2).End(xlUp).row
    
    For row = 2 To lastRow
        If Trim(ws.Cells(row, 2).value) = Trim(packCode) Then
            FindPackInControlTable = row
            Exit Function
        End If
    Next row
    
    FindPackInControlTable = 0
End Function

