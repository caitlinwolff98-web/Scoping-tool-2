        ws.Cells(row, 3).value = mapping("PackCode")
        ws.Cells(row, 4).value = mapping("ConsolPackName")
        ws.Cells(row, 5).value = mapping("ConsolPackCode")
        ws.Cells(row, 6).value = mapping("ConsolDivision")
