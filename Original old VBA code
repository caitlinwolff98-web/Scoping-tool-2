        lastCol = ws.Cells(6, ws.columns.count).End(xlToLeft).Column
        
        For col = 3 To lastCol
            ' Check if this is consolidation currency column
            Dim colType As String
            colType = Trim(ws.Cells(6, col).value)
            
            If InStr(1, colType, "consolidation", vbTextCompare) > 0 Then
                packCode = Trim(ws.Cells(8, col).value)
                packName = Trim(ws.Cells(7, col).value)
                
                If packCode <> "" And packName <> "" Then
                    If Not packDict.Exists(packCode) Then
                        Dim packInfo As Object
                        Set packInfo = CreateObject("Scripting.Dictionary")
                        packInfo("PackName") = packName
                        packInfo("PackCode") = packCode
                        packInfo("DivisionName") = divisionName
                        
                        packDict.Add packCode, packInfo
                    End If
                End If
            End If
        Next col
    Next i
    
    ' Write headers
    outputWs.Cells(1, 1).value = "Pack Code"
    outputWs.Cells(1, 2).value = "Pack Name"
    outputWs.Cells(1, 3).value = "Division/Segment"
    
    ' Write data
    row = 2
    Dim packKeys As Variant
    packKeys = packDict.Keys
    
    For i = 0 To UBound(packKeys)
        Dim packDetail As Object
        Set packDetail = packDict(packKeys(i))
        
        outputWs.Cells(row, 1).value = packDetail("PackCode")
        outputWs.Cells(row, 2).value = packDetail("PackName")
        outputWs.Cells(row, 3).value = packDetail("DivisionName")
        
        row = row + 1
    Next i
    
    ' Get dimensions
    lastRow = outputWs.Cells(outputWs.Rows.count, 1).End(xlUp).row
    lastCol = 3
    
    ' Create table
    If lastRow > 1 Then
        On Error Resume Next
        Set tbl = outputWs.ListObjects.Add(xlSrcRange, outputWs.Range(outputWs.Cells(1, 1), outputWs.Cells(lastRow, lastCol)), , xlYes)
        If Not tbl Is Nothing Then
            tbl.Name = "Pack_Number_Company_Table"
            tbl.TableStyle = "TableStyleMedium2"
        End If
        On Error GoTo ErrorHandler
    End If
    
    outputWs.columns.AutoFit
    
    Exit Sub
    
ErrorHandler:
    Debug.Print "Error creating Pack Number Company Table: " & Err.Description
End Sub

