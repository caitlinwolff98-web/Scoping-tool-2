' ============================================================================
' CREATE SCOPING CONTROL TABLE - FIXED VERSION (NO DUPLICATES) - OPTIMIZED
' ============================================================================
Public Sub CreateScopingControlTable()
    On Error GoTo ErrorHandler
    
    Dim ws As Worksheet
    Dim inputTab As Worksheet
    Dim row As Long
    Dim dataRow As Long
    Dim col As Long
    Dim lastCol As Long
    Dim lastRow As Long
    Dim packCode As String
    Dim packName As String
    Dim fsliName As String
    Dim amount As Variant
    Dim packDict As Object
    Dim division As String
    Dim uniqueKey As String
    Dim processedCount As Long
    Dim inputData As Variant
    
    ' Performance settings
    Dim calcMode As Long
    calcMode = Application.Calculation
    Application.Calculation = xlCalculationManual
    
    ' Create dictionary to track processed pack-FSLi combinations
    Set packDict = CreateObject("Scripting.Dictionary")
    
    ' Delete existing sheet if it exists
    On Error Resume Next
    Application.DisplayAlerts = False
    g_OutputWorkbook.Worksheets("Scoping Control Table").Delete
    Application.DisplayAlerts = True
    On Error GoTo ErrorHandler
    
    ' Create worksheet
    Set ws = g_OutputWorkbook.Worksheets.Add
    ws.Name = "Scoping Control Table"
    
    ' Get input tab
    Set inputTab = ModTableGeneration.GetTabByCategory(ModConfig.CAT_INPUT_CONTINUING)
    If inputTab Is Nothing Then
        MsgBox "Input Continuing tab not found!", vbCritical
        GoTo CleanUp
    End If
    
    ' Set up headers
    row = 1
    With ws
        .Cells(row, 1).value = "Pack Name"
        .Cells(row, 2).value = "Pack Code"
        .Cells(row, 3).value = "Division"
        .Cells(row, 4).value = "FSLi"
        .Cells(row, 5).value = "Amount"
        .Cells(row, 6).value = "Scoping Status"
        .Cells(row, 7).value = "Is Consolidated"
        .Cells(row, 8).value = "Percentage of Total"
        .Cells(row, 9).value = "Manual Override"
        .Cells(row, 10).value = "Override Date"
        .Cells(row, 11).value = "Override By"
        
        ' Format headers
        .Range("A1:K1").Font.Bold = True
        .Range("A1:K1").Interior.Color = RGB(68, 114, 196)
        .Range("A1:K1").Font.Color = RGB(255, 255, 255)
        row = row + 1
        
        ' Get dimensions
        lastCol = inputTab.Cells(7, inputTab.columns.count).End(xlToLeft).Column
        lastRow = inputTab.Cells(inputTab.Rows.count, 2).End(xlUp).row
        
        ' Load all input data into memory for faster processing
        If lastRow > 8 And lastCol > 2 Then
            inputData = inputTab.Range(inputTab.Cells(1, 1), inputTab.Cells(lastRow, lastCol)).value
        Else
            MsgBox "No data found in Input Continuing tab!", vbCritical
            GoTo CleanUp
        End If
        
        ' First pass: Collect all unique pack-FSLi combinations and sum amounts
        processedCount = 0
        For col = 3 To lastCol
            ' Show progress
            If col Mod 10 = 0 Then
                Application.StatusBar = "Processing column " & col & " of " & lastCol & "..."
                DoEvents
            End If
            
            packCode = Trim(CStr(inputData(8, col)))
            packName = Trim(CStr(inputData(7, col)))
            
            If packCode <> "" And packName <> "" Then
                ' Iterate through each FSLi
                For dataRow = 9 To lastRow
                    processedCount = processedCount + 1
                    
                    fsliName = Trim(CStr(inputData(dataRow, 2)))
                    
                    ' Only process valid FSLi rows
                    If fsliName <> "" And Not IsStatementHeader(fsliName) Then
                        ' Create unique key
                        uniqueKey = packCode & "|" & fsliName
                        
                        ' Get amount
                        amount = inputData(dataRow, col)
                        If Not IsNumeric(amount) Then amount = 0
                        
                        ' If this combination exists, add to existing amount
                        If packDict.Exists(uniqueKey) Then
                            Dim existingData As Object
                            Set existingData = packDict(uniqueKey)
                            existingData("Amount") = existingData("Amount") + CDbl(amount)
                        Else
                            ' Create new entry
                            Dim newData As Object
                            Set newData = CreateObject("Scripting.Dictionary")
                            newData.Add "PackCode", packCode
                            newData.Add "PackName", packName
                            newData.Add "FSLi", fsliName
                            newData.Add "Amount", CDbl(amount)
                            packDict.Add uniqueKey, newData
                        End If
                    End If
                Next dataRow
            End If
        Next col
        
        ' Show progress
        Application.StatusBar = "Writing " & packDict.count & " unique combinations to sheet..."
        DoEvents
        
        ' Prepare output array for batch writing
        Dim outputData() As Variant
        ReDim outputData(1 To packDict.count, 1 To 11)
        
        ' Second pass: Write unique combinations to array
        Dim key As Variant
        Dim data As Object
        Dim outputRow As Long
        
        outputRow = 1
        For Each key In packDict.Keys
            Set data = packDict(key)
            
            ' Get division for this pack
            division = GetPackDivisionFromTable(data("PackCode"))
            
            ' Write to array
            outputData(outputRow, 1) = data("PackName")
            outputData(outputRow, 2) = data("PackCode")
            outputData(outputRow, 3) = division
            outputData(outputRow, 4) = data("FSLi")
            outputData(outputRow, 5) = data("Amount")
            outputData(outputRow, 6) = IIf(data("PackCode") = g_ConsolidatedPackCode, "Consolidated", "Not Scoped")
            outputData(outputRow, 7) = IIf(data("PackCode") = g_ConsolidatedPackCode, "Yes", "No")
            outputData(outputRow, 8) = "" ' Percentage formula added later
            outputData(outputRow, 9) = "No"
            outputData(outputRow, 10) = "" ' Override date
            outputData(outputRow, 11) = "" ' Override by
            
            outputRow = outputRow + 1
        Next key
        
        ' Write all data at once
        If packDict.count > 0 Then
            .Range(.Cells(2, 1), .Cells(packDict.count + 1, 11)).value = outputData
            
            ' Add percentage formulas
            Dim formulaRow As Long
            For formulaRow = 2 To packDict.count + 1
                .Cells(formulaRow, 8).Formula = "=IF($B" & formulaRow & "=$B$2,E" & formulaRow & "/SUMIFS($E:$E,$D:$D,$D" & formulaRow & ",$B:$B,""<>""&$B$2),0)"
            Next formulaRow
            
            ' Format numbers
            .columns("E:E").NumberFormat = "#,##0.00"
            .columns("H:H").NumberFormat = "0.00%"
        End If
        
        ' Auto-fit columns
        .columns("A:K").AutoFit
        
        ' Create table
        If packDict.count > 0 Then
            Dim tbl As ListObject
            On Error Resume Next
            Set tbl = .ListObjects.Add(xlSrcRange, .Range(.Cells(1, 1), .Cells(packDict.count + 1, 11)), , xlYes)
            If Not tbl Is Nothing Then
                tbl.Name = "Scoping_Control_Table"
                tbl.TableStyle = "TableStyleMedium2"
                
                ' Add data validation for Scoping Status
                With tbl.ListColumns("Scoping Status").DataBodyRange.Validation
                    .Delete
                    .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, _
                        Formula1:="Scoped In,Not Scoped,Scoped Out,Consolidated"
                End With
                
                ' Add data validation for Manual Override
                With tbl.ListColumns("Manual Override").DataBodyRange.Validation
                    .Delete
                    .Add Type:=xlValidateList, AlertStyle:=xlValidAlertStop, _
                        Formula1:="Yes,No"
                End With
            End If
            On Error GoTo ErrorHandler
        End If
        
        ' Add conditional formatting
        AddConditionalFormatting ws, packDict.count + 1
        
    End With
    
    Application.StatusBar = False
    
    MsgBox "Scoping Control Table created successfully with " & packDict.count & " unique pack-FSLi combinations.", vbInformation
    
CleanUp:
    Application.Calculation = calcMode
    Application.StatusBar = False
    Exit Sub
    
ErrorHandler:
    Application.Calculation = calcMode
    Application.StatusBar = False
    MsgBox "Error creating Scoping Control Table: " & Err.Description, vbCritical
End Sub

' Helper function to check if a string is a statement header
Private Function IsStatementHeader(fsli As String) As Boolean
    Dim headers As Variant
    Dim i As Long
    
    headers = Array("INCOME STATEMENT", "BALANCE SHEET", "STATEMENT OF", "TOTAL", "NET", "SUBTOTAL", "Notes")
    
    For i = 0 To UBound(headers)
        If InStr(1, UCase(fsli), UCase(headers(i))) > 0 Then
            IsStatementHeader = True
            Exit Function
        End If
    Next i
    
    IsStatementHeader = False
End Function

' Add conditional formatting to the scoping control table
Private Sub AddConditionalFormatting(ws As Worksheet, lastRow As Long)
    On Error Resume Next
    
    Dim rng As Range
    Set rng = ws.Range("F2:F" & lastRow)
    
    ' Clear existing formatting
    rng.FormatConditions.Delete
    
    ' Scoped In = Green
    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""Scoped In""")
        .Interior.Color = RGB(198, 239, 206)
        .Font.Color = RGB(0, 97, 0)
    End With
    
    ' Scoped Out = Red
    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""Scoped Out""")
        .Interior.Color = RGB(255, 199, 206)
        .Font.Color = RGB(156, 0, 6)
    End With
    
    ' Not Scoped = Yellow
    With rng.FormatConditions.Add(Type:=xlCellValue, Operator:=xlEqual, Formula1:="=""Not Scoped""")
        .Interior.Color = RGB(255, 235, 156)
        .Font.Color = RGB(156, 101, 0)
    End With
    
    On Error GoTo 0
End Sub

' Helper function to get division from Pack Number Company Table (optimized with caching)
Private Function GetPackDivisionFromTable(packCode As String) As String
    On Error Resume Next
    
    Static packDivisions As Object
    Static lastLoadTime As Date
    
    ' Cache pack divisions for 60 seconds
    If packDivisions Is Nothing Or DateDiff("s", lastLoadTime, Now) > 60 Then
        Set packDivisions = CreateObject("Scripting.Dictionary")
        lastLoadTime = Now
        
        Dim packWs As Worksheet
        Set packWs = g_OutputWorkbook.Worksheets("Pack Number Company Table")
        
        If Not packWs Is Nothing Then
            Dim lastRow As Long
            Dim packData As Variant
            Dim i As Long
            
            lastRow = packWs.Cells(packWs.Rows.count, 2).End(xlUp).row
            
            ' Load all data at once
            If lastRow > 1 Then
                packData = packWs.Range(packWs.Cells(2, 2), packWs.Cells(lastRow, 3)).value
                
                ' Build dictionary
                For i = 1 To UBound(packData, 1)
                    If Trim(CStr(packData(i, 1))) <> "" Then
                        packDivisions(Trim(CStr(packData(i, 1)))) = Trim(CStr(packData(i, 2)))
                    End If
                Next i
            End If
        End If
    End If
    
    ' Look up from cache
    If packDivisions.Exists(packCode) Then
        GetPackDivisionFromTable = packDivisions(packCode)
    Else
        GetPackDivisionFromTable = "Unknown"
    End If
    
    On Error GoTo 0
End Function

