    row = row + 1
    
    ' Process pack data
    For dataRow = 2 To UBound(sourceData, 1)
        ' Show progress
        If dataRow Mod 50 = 0 Then
            Application.StatusBar = "Processing entity " & dataRow & " of " & UBound(sourceData, 1)
            DoEvents
        End If
        
        outputData(row, 1) = sourceData(dataRow, 1) ' Pack Name
        outputData(row, 2) = sourceData(dataRow, 2) ' Pack Code
        outputData(row, 3) = sourceData(dataRow, 3) ' Division
        outputData(row, 4) = sourceData(dataRow, 4) ' Segment
        
        ' Check if consolidated entity
        If sourceData(dataRow, 2) = g_ConsolidatedPackCode Then
            outputData(row, 5) = "Consolidated"
            outputData(row, 6) = "N/A"
            outputData(row, 7) = "N/A"
            outputData(row, 8) = "Excluded"
        Else
            outputData(row, 5) = "Not Scoped"
            outputData(row, 6) = "N/A"
            outputData(row, 7) = "No"
            outputData(row, 8) = "Not Scoped"
        End If
        
        row = row + 1
    Next dataRow
    
    ' Add summary statistics
    row = row + 1
    outputData(row, 1) = "SUMMARY STATISTICS"
    row = row + 1
    
    outputData(row, 1) = "Total Packs (excl. consolidated):"
    outputData(row, 2) = "=COUNTIF(H:H,""<>Excluded"")"
    row = row + 1
    
    outputData(row, 1) = "Initially Scoped In:"
    outputData(row, 2) = "=COUNTIF(H:H,""Scoped In"")"
    row = row + 1
    
    outputData(row, 1) = "Scoping Percentage:"
    outputData(row, 2) = "=B" & row - 1 & "/B" & row - 2
    
    ' Write all data at once
    ws.Range("A1").Resize(row - 1, 8).value = outputData
    
    ' Apply formatting
    With ws
        .Range("A1").Font.Bold = True
        .Range("A1").Font.Size = 16
        .Range("A1").Font.Color = RGB(0, 32, 96)
        
        ' Headers
        Dim headerRow As Long
        headerRow = 7
        .Range(.Cells(headerRow, 1), .Cells(headerRow, 8)).Font.Bold = True
        .Range(.Cells(headerRow, 1), .Cells(headerRow, 8)).Interior.Color = RGB(217, 225, 242)
        .Range(.Cells(headerRow, 1), .Cells(headerRow, 8)).Borders.LineStyle = xlContinuous
        
        ' Create table
        If row - headerRow > 2 Then
            On Error Resume Next
            Dim tbl As ListObject
            Set tbl = .ListObjects.Add(xlSrcRange, .Range(.Cells(headerRow, 1), .Cells(lastRow + 6, 8)), , xlYes)
            If Not tbl Is Nothing Then
                tbl.Name = "EntityScopingSummaryTable"
                tbl.TableStyle = "TableStyleMedium2"
            End If
            On Error GoTo ErrorHandler
        End If
        
        ' Summary statistics formatting
        On Error Resume Next
        .Cells.Find("SUMMARY STATISTICS").Font.Bold = True
        .Cells.Find("SUMMARY STATISTICS").Font.Size = 14
        .Cells.Find("SUMMARY STATISTICS").Interior.Color = RGB(217, 225, 242)
        On Error GoTo ErrorHandler
        
        ' Format percentage
        .Cells(row - 1, 2).NumberFormat = "0.0%"
        
        .columns.AutoFit
    End With
    
    Exit Sub
    
ErrorHandler:
    ModConfig.ShowError "Entity Summary Error", "Error creating entity scoping summary: " & Err.Description, Err.Number
End Sub
