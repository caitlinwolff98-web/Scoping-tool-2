' Create the manual scoping interface sheet
Private Sub CreateManualScopingSheet()
    On Error GoTo ErrorHandler
    
    Dim ws As Worksheet
    Dim fullInputWs As Worksheet
    Dim percentWs As Worksheet
    Dim lastRow As Long
    Dim lastCol As Long
    Dim row As Long
    Dim col As Long
    Dim outRow As Long
    
    ' Check if sheet exists and delete it
    On Error Resume Next
    Application.DisplayAlerts = False
    g_OutputWorkbook.Worksheets("Manual Scoping").Delete
    Application.DisplayAlerts = True
    On Error GoTo ErrorHandler
    
    ' Create new sheet
    Set ws = g_OutputWorkbook.Worksheets.Add
    ws.Name = "Manual Scoping"
    
    ' Get source data
    Set fullInputWs = g_OutputWorkbook.Worksheets("Full Input Table")
    Set percentWs = g_OutputWorkbook.Worksheets("Full Input Percentage")
    
    If fullInputWs Is Nothing Or percentWs Is Nothing Then
        MsgBox "Required tables not found. Please run data processing first.", vbCritical
        Exit Sub
    End If
    
    ' Get dimensions
    lastRow = fullInputWs.Cells(fullInputWs.Rows.count, 1).End(xlUp).row
    lastCol = fullInputWs.Cells(1, fullInputWs.columns.count).End(xlToLeft).Column
    
    ' Create headers
    ws.Cells(1, 1).value = "MANUAL SCOPING INTERFACE"
    ws.Cells(1, 1).Font.Bold = True
    ws.Cells(1, 1).Font.Size = 14
    ws.Cells(1, 1).Font.Color = RGB(68, 114, 196)
    ws.Range("A1:M1").Merge
    
    ' Instructions
    ws.Cells(2, 1).value = "Instructions: Use filters to find packs/FSLIs. Select scoping status from dropdown in column M. Click 'Update Scoping' button to save changes."
    ws.Cells(2, 1).Font.Italic = True
    ws.Cells(2, 1).Font.Size = 9
    ws.Range("A2:M2").Merge
    
    ' Column headers (Row 4)
    outRow = 4
    ws.Cells(outRow, 1).value = "Pack Name"
    ws.Cells(outRow, 2).value = "Pack Code"
    ws.Cells(outRow, 3).value = "Segment"
    ws.Cells(outRow, 4).value = "FSLI"
    ws.Cells(outRow, 5).value = "Statement Type"
    ws.Cells(outRow, 6).value = "Hierarchy"
    ws.Cells(outRow, 7).value = "Amount"
    ws.Cells(outRow, 8).value = "% of Total"
    ws.Cells(outRow, 9).value = "Amount Rank"
    ws.Cells(outRow, 10).value = "% Rank"
    ws.Cells(outRow, 11).value = "Materiality Flag"
    ws.Cells(outRow, 12).value = "Current Status"
    ws.Cells(outRow, 13).value = "Scoping Decision"
    
    ' Format headers
    With ws.Range("A4:M4")
        .Font.Bold = True
        .Interior.Color = RGB(68, 114, 196)
        .Font.Color = RGB(255, 255, 255)
        .HorizontalAlignment = xlCenter
    End With
    
    ' Build detailed scoping data
    outRow = 5
    Dim packName As String
    Dim packCode As String
    Dim segment As String
    Dim fsliName As String
    Dim amount As Double
    Dim percentage As Double
    
    ' For each pack (row in Full Input Table)
    For row = 2 To lastRow
        packName = fullInputWs.Cells(row, 1).value
        packCode = fullInputWs.Cells(row, 2).value
        segment = fullInputWs.Cells(row, 3).value
        
        ' For each FSLI (column in Full Input Table, starting from col 4)
        For col = 4 To lastCol
            fsliName = fullInputWs.Cells(1, col).value
            amount = 0
            percentage = 0
            
            ' Get amount
            If IsNumeric(fullInputWs.Cells(row, col).value) Then
                amount = CDbl(fullInputWs.Cells(row, col).value)
            End If
            
            ' Get percentage
            If IsNumeric(percentWs.Cells(row, col).value) Then
                percentage = CDbl(percentWs.Cells(row, col).value) * 100  ' Convert to percentage
            End If
            
            ' Skip if amount is zero or very small
            If Abs(amount) < 1000 Then GoTo NextFSLI
            
            ' Write row
            ws.Cells(outRow, 1).value = packName
            ws.Cells(outRow, 2).value = packCode
            ws.Cells(outRow, 3).value = segment
            ws.Cells(outRow, 4).value = fsliName
            
            ' Get FSLI metadata from FSLi Key Table
            Dim fsliMeta As Object
            Set fsliMeta = GetFSLIMetadata(fsliName)
            
            ws.Cells(outRow, 5).value = fsliMeta("StatementType")
            ws.Cells(outRow, 6).value = fsliMeta("HierarchyType")
            ws.Cells(outRow, 7).value = amount
            ws.Cells(outRow, 7).NumberFormat = "#,##0"
            ws.Cells(outRow, 8).value = percentage / 100
            ws.Cells(outRow, 8).NumberFormat = "0.00%"
            
            ' Ranks (will be calculated after all data is loaded)
            ws.Cells(outRow, 9).value = "TBD"
            ws.Cells(outRow, 10).value = "TBD"
            
            ' Materiality flag (if >5% of total)
            If percentage > 5 Then
                ws.Cells(outRow, 11).value = "Material"
                ws.Cells(outRow, 11).Interior.Color = RGB(255, 235, 156)
            Else
                ws.Cells(outRow, 11).value = "Below threshold"
            End If
            
            ' Current status (initially "Not Scoped Yet")
            ws.Cells(outRow, 12).value = "Not Scoped Yet"
            
            ' Scoping decision dropdown (will be added via data validation)
            ws.Cells(outRow, 13).value = "Not Scoped Yet"
            
            outRow = outRow + 1
            
NextFSLI:
        Next col
    Next row
    
    ' Calculate ranks
    CalculateRanks ws, 5, outRow - 1
    
    ' Add data validation for scoping dropdown (column M)
    Dim dvRange As Range
    Set dvRange = ws.Range("M5:M" & (outRow - 1))
    
    With dvRange.Validation
        .Delete
        .Add Type:=xlValidateList, _
             AlertStyle:=xlValidAlertStop, _
             Operator:=xlBetween, _
             Formula1:="Scope In,Scoped Out,Not Scoped Yet,Under Review"
        .IgnoreBlank = True
        .InCellDropdown = True
        .ShowError = True
        .errorTitle = "Invalid Entry"
        .errorMessage = "Please select a valid scoping status from the dropdown."
    End With
    
    ' Create table for filtering
    Dim tbl As ListObject
    On Error Resume Next
    Set tbl = ws.ListObjects.Add(xlSrcRange, ws.Range("A4:M" & (outRow - 1)), , xlYes)
    If Not tbl Is Nothing Then
        tbl.Name = "Manual_Scoping_Table"
        tbl.TableStyle = "TableStyleMedium2"
        tbl.ShowAutoFilter = True
    End If
    On Error GoTo ErrorHandler
    
    ' Add Update button
    Dim btn As Button
    Set btn = ws.Buttons.Add(10, 50, 150, 30)
    btn.OnAction = "UpdateScopingFromManualSheet"
    btn.Text = "Update Scoping Tables"
    btn.Font.Bold = True
    
    ' Auto-fit columns
    ws.columns.AutoFit
    
    ' Freeze panes
    ws.Activate
    ws.Range("A5").Select
    ActiveWindow.FreezePanes = True
    
    Exit Sub
    
ErrorHandler:
    Debug.Print "Error creating Manual Scoping sheet: " & Err.Description
End Sub

' Get FSLI metadata from FSLi Key Table
Private Function GetFSLIMetadata(fsliName As String) As Object
    On Error Resume Next
    
    Dim meta As Object
    Set meta = CreateObject("Scripting.Dictionary")
    
    Dim fsliKeyWs As Worksheet
    Set fsliKeyWs = g_OutputWorkbook.Worksheets("FSLi Key Table")
    
    If Not fsliKeyWs Is Nothing Then
        Dim lastRow As Long
        Dim row As Long
        
        lastRow = fsliKeyWs.Cells(fsliKeyWs.Rows.count, 1).End(xlUp).row
        
        For row = 2 To lastRow
            If Trim(fsliKeyWs.Cells(row, 1).value) = Trim(fsliName) Then
                meta("StatementType") = fsliKeyWs.Cells(row, 2).value
                meta("HierarchyType") = fsliKeyWs.Cells(row, 3).value
                meta("Level") = fsliKeyWs.Cells(row, 4).value
                meta("IsTotal") = (fsliKeyWs.Cells(row, 5).value = "Yes")
                Exit For
            End If
        Next row
    End If
    
    ' Defaults if not found
    If Not meta.Exists("StatementType") Then meta("StatementType") = "Unknown"
    If Not meta.Exists("HierarchyType") Then meta("HierarchyType") = "Item"
    If Not meta.Exists("Level") Then meta("Level") = 0
    If Not meta.Exists("IsTotal") Then meta("IsTotal") = False
    
    Set GetFSLIMetadata = meta
    
    On Error GoTo 0
End Function

' Calculate amount and percentage ranks
Private Sub CalculateRanks(ws As Worksheet, startRow As Long, endRow As Long)
    On Error Resume Next
    
    Dim row As Long
    Dim amountRank As Long
    Dim percentRank As Long
    
    ' For each row, calculate rank based on amount and percentage
    For row = startRow To endRow
        ' Amount rank formula
        ws.Cells(row, 9).Formula = "=RANK(ABS($G" & row & "),$G$" & startRow & ":$G$" & endRow & ",0)"
        
        ' Percentage rank formula
        ws.Cells(row, 10).Formula = "=RANK($H" & row & ",$H$" & startRow & ":$H$" & endRow & ",0)"
    Next row
    
    On Error GoTo 0
End Sub

